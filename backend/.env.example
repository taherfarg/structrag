# Copy to backend/.env. Local values come from `npx supabase status`.
DATABASE_URL=postgresql://postgres:postgres@127.0.0.1:55422/postgres
SUPABASE_URL=http://127.0.0.1:55421
# Server-side only. Never ship this to the browser.
SUPABASE_SECRET_KEY=
# Browser-safe; the backend only uses it in integration tests.
SUPABASE_PUBLISHABLE_KEY=
# Only for legacy projects that still sign JWTs with HS256.
# SUPABASE_JWT_SECRET=
CORS_ORIGINS=["http://localhost:5173"]

# Any OpenAI-compatible provider. Two tested setups:
#   OpenRouter: LLM_BASE_URL=https://openrouter.ai/api/v1 (costs come back in each response)
#   Gemini:     see the commented block at the end of this file
LLM_BASE_URL=https://openrouter.ai/api/v1
LLM_API_KEY=
# EMBED_BASE_URL=        # defaults to LLM_BASE_URL
# EMBED_API_KEY=         # defaults to LLM_API_KEY
EMBEDDING_MODEL=openai/text-embedding-3-small
EMBEDDING_DIM=1536       # must match vector(1536) in the migration
ROUTER_MODEL=anthropic/claude-haiku-5.5
ANSWER_MODEL=anthropic/claude-haiku-5.5
JUDGE_MODEL=openai/gpt-5.6-luna
LLM_MAX_CONCURRENCY=8
LLM_MAX_ATTEMPTS=6
# LLM_REASONING_EFFORT=low     # sent as reasoning_effort on chat calls
# EMBED_DIMENSIONS=1536        # sent as dimensions on embedding calls
# MODEL_PRICES={"model": [usd_per_1M_input, usd_per_1M_output]}   # for providers that report no cost
CHUNK_MAX_TOKENS=350
MAX_UPLOAD_MB=50
WORKER_ENABLED=true      # false = run `python -m app.ingest.worker` as its own process
LOG_LEVEL=INFO

# --- Google Gemini (OpenAI-compatible endpoint) ---
# LLM_BASE_URL=https://generativelanguage.googleapis.com/v1beta/openai
# EMBEDDING_MODEL=gemini-embedding-001
# EMBED_DIMENSIONS=1536
# ROUTER_MODEL=gemini-3.1-flash-lite
# ANSWER_MODEL=gemini-3.1-flash-lite
# JUDGE_MODEL=gemini-3.8-flash
# LLM_REASONING_EFFORT=low
# MODEL_PRICES={"gemini-3.1-flash-lite": [0.25, 1.5], "gemini-3.8-flash": [0.75, 3.75], "gemini-embedding-001": [0.15, 0]}
